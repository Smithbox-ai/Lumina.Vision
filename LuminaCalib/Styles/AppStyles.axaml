<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- LuminaCalib "Luxury Industrial" Color Palette -->
    <Style>
        <Style.Resources>
            <!-- Fonts -->
            <FontFamily x:Key="InterFont">Segoe UI, Inter, sans-serif</FontFamily>

            <!-- Background Colors -->
            <Color x:Key="DeepCharcoal">#1E1E1E</Color>
            <Color x:Key="ElevatedGray">#2C2C2C</Color>
            <Color x:Key="SurfaceLight">#3C3C3C</Color>
            <Color x:Key="SurfaceLighter">#4A4A4A</Color>
            
            <!-- Primary / Accent Colors -->
            <Color x:Key="NeonCyan">#00E5FF</Color>
            <Color x:Key="NeonCyanDark">#00B4CC</Color>
            <Color x:Key="NeonCyanLight">#66EFFF</Color>
            
            <!-- Status Colors -->
            <Color x:Key="Emerald">#00C853</Color>
            <Color x:Key="Amber">#FFD600</Color>
            <Color x:Key="ErrorRed">#FF5252</Color>
            
            <!-- Text Colors -->
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#B0B0B0</Color>
            <Color x:Key="TextDisabled">#909090</Color>
            
            <!-- Brushes -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource DeepCharcoal}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ElevatedGray}" />
            <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource NeonCyan}" />
            <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource NeonCyanDark}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Emerald}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Amber}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorRed}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}" />

            <!-- Additional semantic colors -->
            <Color x:Key="TitleBarBackground">#252525</Color>
            <Color x:Key="SurfaceDark">#1A1A1A</Color>
            <Color x:Key="VideoBackground">#0D0D0D</Color>
            <Color x:Key="TextMuted">#808080</Color>
            <Color x:Key="TextTertiary">#909090</Color>
            <Color x:Key="TextBright">#CFCFCF</Color>
            <Color x:Key="TextLight">#D0D0D0</Color>
            <Color x:Key="DividerColor">#404040</Color>
            <Color x:Key="BorderSubtle">#333333</Color>
            <Color x:Key="BorderFaint">#2E2E2E</Color>
            <Color x:Key="DangerRed">#D32F2F</Color>
            <Color x:Key="DangerRedHover">#E53935</Color>

            <!-- Additional semantic brushes -->
            <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarBackground}"/>
            <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}"/>
            <SolidColorBrush x:Key="VideoBackgroundBrush" Color="{StaticResource VideoBackground}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
            <SolidColorBrush x:Key="TextBrightBrush" Color="{StaticResource TextBright}"/>
            <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLight}"/>
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
            <SolidColorBrush x:Key="BorderFaintBrush" Color="{StaticResource BorderFaint}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerRed}"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerRedHover}"/>
            <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#CC000000"/>
            <SolidColorBrush x:Key="OverlayDimBrush" Color="#40000000"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource NeonCyanLight}"/>
            <SolidColorBrush x:Key="SurfaceLighterBrush" Color="{StaticResource SurfaceLighter}"/>
        </Style.Resources>
    </Style>
    
    <!-- Window Background -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
    </Style>
    
    <!-- Panel / Border Styles -->
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    
    <Style Selector="Border.elevated">
        <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #40000000" />
    </Style>
    
    <!-- Button Styles -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
    </Style>
    
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.secondary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.danger:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
    </Style>
    
    <!-- TextBlock Styles -->
    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.subheader">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    
    <!-- Status Indicator Styles -->
    <Style Selector="Ellipse.status-connected">
        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    
    <Style Selector="Ellipse.status-disconnected">
        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    
    <Style Selector="Ellipse.status-warning">
        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    
    <!-- Video View Container -->
    <Style Selector="Border.video-container">
        <Setter Property="Background" Value="{StaticResource VideoBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- Workflow Stepper -->
    <Style Selector="Border.step-active">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    
    <Style Selector="Border.step-complete">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
    </Style>
    
    <Style Selector="Border.step-pending">
        <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
    </Style>

    <!-- Focus Adorner for Keyboard Navigation -->
    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Validation Error Styles -->
    <Style Selector="TextBox.validation-error">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="TextBlock.validation-error-text">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    
</Styles>
